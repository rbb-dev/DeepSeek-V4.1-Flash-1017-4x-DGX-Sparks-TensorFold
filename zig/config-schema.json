   "id": 934,
   "name": "tf_ds_attn_twin",
   "env": "TF_DS_ATTN_TWIN",
   "group": "prompt",
   "tab": "Advanced",
   "kind": "enum",
   "unit": "",
   "min": null,
   "max": null,
   "default": "z",
   "default_check": "none",
   "apply": "R",
   "who": [
    "admin"
   ],
   "label": "Sparse attention kernel variant",
   "doc": "Which build of the packed-latent sparse attention the calls of TF_DS_ATTN_U (prompt chunks) and TF_DS_ATTN_U_DECODE (decode rounds) launch. u is the standard kernel (the FP4 latents unpacked in hardware). w reads the latents' scale bytes in the code bytes' own layout and unpacks the code bytes where they sit in their registers: 136 fewer instructions and 4 fewer barriers a key block. x is w, reading the next block's pick indices a block ahead and, in the fused attention epilogue, prefetching the next block's rows into the GPU's first-level cache (opt-in until a timing shows it faster than z). z is w, and in a decode round it also prefetches the picked rows into the GPU cache before it waits for the kernel before. All of them give the same bytes (the kernels replay compares them); It runs z unless set (a bit-identical speed change is on by default); u, w or x selects another. Needs TF_DS_ATTN_U or TF_DS_ATTN_U_DECODE and the kernel kit's extra set; without them, or with a kit that lacks the kernel, the engine runs u and says so in an 'off' line of the speed report. A value other than u, w, x or z refuses the start by name. The fused attention epilogue (TF_DS_ATTN_EPI_FUSED) has its own switch, TF_DS_ATTN_EPI_TWIN; this one does not move it.",
   "values": [
    "u",
    "w",
    "x",
    "z"
   ],
   "seed": "name",
   "first_use": "families/dsv41/model.zig:2005",
   "secret": false
  },

   ],
   "label": "L2 prefetch: chunk size",
   "doc": "The size of each bulk prefetch of the L2 prefetch that runs beside the decode exchanges: 8 (the default, as served), or 1, 2, 4, 16 KiB. A wave is 128 chunks, so the memory queue a wave puts ahead of the network card's reads and the staging copies is 128 x the chunk; a smaller chunk with the same rate (the wave period scales with it) leaves a shallower queue. Bit-identical: it touches no value, only when the same cache lines are fetched; replies do not change. Values other than 1, 2, 4, 8, 16 refuse the start. Each rank reads its own setting.",
   "values": [],
   "seed": "name",
   "first_use": "families/dsv41/model.zig:2440",
   "secret": false
  },

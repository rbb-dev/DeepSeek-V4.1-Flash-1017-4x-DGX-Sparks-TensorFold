+    /// The running pass as the HTTP threads report it (the lock held); null when none runs.
+    fn passNow(h: *LaneHost, now: i96) ?api.PromptPass {
+        if (!h.pass_on) return null;
+        const r = h.pass.read();
+        const resumed = @min(r.from, h.pass_len);
+        return .{
+            .computed = r.at -| r.from,
+            .total = h.pass_len - resumed,
+            .resumed = resumed,
+            .seconds = @as(f64, @floatFromInt(@max(0, now - h.pass_began))) / 1e9,
+        };
